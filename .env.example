# Disposable local MongoDB replica set; the app uses the cliniq database.
MONGODB_URI=mongodb://127.0.0.1:27029/?directConnection=true&replicaSet=rs0
MONGODB_TEST_URI=mongodb://127.0.0.1:27029/?directConnection=true&replicaSet=rs0

# Generate each secret locally, e.g. openssl rand -hex 32. Do not commit real values.
AUTH_SECRET=
DEMO_DOCTOR_PASSWORD=
DEMO_RECEPTIONIST_PASSWORD=

# Optional for live synthetic speech and AI extraction tests.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MEDIFLOW_METRICS=1
